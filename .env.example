# Prefix API backend (App B :4000) yang di-bake ke bundle saat build.
# Nilainya harus cocok dengan `location` di nginx yang ada di depan dashboard:
#   location /api-b/ { proxy_pass http://localhost:4000/; }
#
# JANGAN isi dengan origin polos (mis. https://call-qc-huawei.bankmega.local)
# atau path lain: nginx yang sama punya `location /auth/login` yang menunjuk
# App C :8008 — API login yang beda (JSON {nip,password}) — sehingga login
# dashboard dijawab 422 Unprocessable Content.
#
# Akses langsung dari host tanpa nginx : http://localhost:4000
# Di balik nginx call-qc/huawei        : /api-b   <- dipakai produksi
VITE_API_URL=/api-b
